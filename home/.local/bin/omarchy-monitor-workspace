#!/usr/bin/env python3
"""Address workspaces relative to the focused monitor.

Each monitor owns a block of workspace ids (see monitor-workspaces.json), so
"workspace 3" means a different workspace on each display. Pressing SUPER+3 or
clicking 3 in the bar therefore opens a workspace on the monitor you are
already looking at instead of pulling focus to whichever display happens to
own the global workspace 3.

    omarchy-monitor-workspace focus 3        switch to this monitor's 3
    omarchy-monitor-workspace move 3         send the active window there
    omarchy-monitor-workspace move 3 --stay  ...without following it
    omarchy-monitor-workspace absolute 3     print the real workspace id
"""

import json
import os
import subprocess
import sys

CONFIG = os.path.expanduser("~/.config/omarchy/monitor-workspaces.json")


def hypr(*args):
    out = subprocess.run(
        ["hyprctl", "-j"] + list(args), capture_output=True, text=True, check=True
    )
    return json.loads(out.stdout)


def dispatch(lua):
    subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, text=True)


def config():
    try:
        with open(CONFIG) as fh:
            data = json.load(fh)
    except Exception:
        return {}, 10
    return data.get("bases") or {}, int(data.get("size") or 10)


def focused_monitor():
    for monitor in hypr("monitors"):
        if monitor.get("focused"):
            return monitor["name"]
    return ""


def absolute(relative, monitor=None):
    """Map a 1-N workspace number onto the focused monitor's block."""
    bases, size = config()
    if not 1 <= relative <= size:
        return relative
    base = bases.get(monitor if monitor is not None else focused_monitor())
    # An unmapped monitor (newly plugged in, say) keeps plain global numbering.
    return relative + base if base is not None else relative


def parse(argv):
    try:
        return int(argv[0])
    except (IndexError, ValueError):
        print("usage: omarchy-monitor-workspace <focus|move|absolute> <1-N>", file=sys.stderr)
        raise SystemExit(2)


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    action, rest = argv[0], argv[1:]
    target = absolute(parse(rest))

    if action == "focus":
        dispatch('hl.dsp.focus({ workspace = "%d" })' % target)
    elif action == "move":
        follow = "--stay" not in rest
        dispatch(
            'hl.dsp.window.move({ workspace = "%d", follow = %s })'
            % (target, "true" if follow else "false")
        )
    elif action == "absolute":
        print(target)
    else:
        print("unknown action: %s" % action, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
